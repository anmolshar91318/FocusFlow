# FocusFlow Backend Environment Variables

# Google Gemini API Key for AI Assistant
GEMINI_API_KEY=

# Neon PostgreSQL Database Connection URL
# Set this to your Neon DB connection string. If left blank, FocusFlow falls back to local SQLite (.db file).
# Example: postgresql://neondb_owner:npg_xyz@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=
DATABASE_URL=

# CORS & Frontend Origins (comma-separated, optional)
# By default, localhost on all ports and all *.vercel.app deployments are allowed
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =============================================================================
# Google SMTP / Email Verification & Forgot Password Setup
# =============================================================================
# How to get your Google SMTP App Password:
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Make sure "2-Step Verification" is turned ON.
# 3. Search for "App passwords" or visit https://myaccount.google.com/apppasswords
# 4. Create a new app password named "FocusFlow" (it will give you a 16-character password).
# 5. Paste the 16-character code into SMTP_PASSWORD below (spaces are automatically removed).
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=FocusFlow <your-email@gmail.com>
SMTP_FROM_NAME=FocusFlow
SMTP_USE_TLS=true
SMTP_USE_SSL=false
